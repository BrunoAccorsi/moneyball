# Copy to .env before `docker compose up`. Change every secret before a public deploy.

POSTGRES_USER=moneyball
POSTGRES_PASSWORD=moneyball
POSTGRES_DB=moneyball
WEB_PORT=3000

# Plain password is hashed in memory with bcrypt and is not written to Postgres.
# Prefer AUTH_PASSWORD_HASH and leave AUTH_PASSWORD empty in production.
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'your-password'
AUTH_PASSWORD=change-me
AUTH_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Categorization LLM stays off when this is empty.
CATEGORIZATION_LLM_API_KEY=
CATEGORIZATION_LLM_BASE_URL=https://api.openai.com/v1
CATEGORIZATION_LLM_MODEL=gpt-4o-mini

# Traefik / Dokploy. Leave TRAEFIK_ENABLE false if Dokploy creates the router
# from the domain you set in its UI. No production hostname is baked in.
TRAEFIK_ENABLE=false
APP_DOMAIN=moneyball.localhost
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_NETWORK=dokploy-network
